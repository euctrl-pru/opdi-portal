# Copy to .env and fill in local values. .env is gitignored; never commit it.
#
# The portal renders without a .env — every variable below has a fallback in
# R/portal_config.R. Set them only when your local paths, credentials, or
# analytics differ from the defaults.

# Absolute path to the raw data drop used by the data-processing scripts.
# Not needed to render the site (data/02_analytic_data/ is committed).
OPDI_RAW_DATA_DIR=

# Matomo analytics. The site ID is public (it ships in the rendered HTML);
# blank it locally to avoid polluting production stats while developing.
OPDI_MATOMO_URL=//stats.eurocontrol.int/
OPDI_MATOMO_SITE_ID=26

# OpenSky Network API credentials.
# Request at https://opensky-network.org/ (account -> API client).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# OPDI Sensors provisioning-host credentials.
OPDI_SENSORS_PH_USR=
OPDI_SENSORS_PH_PWD=
