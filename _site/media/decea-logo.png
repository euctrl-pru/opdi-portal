#glossario { border-right:none !important; color:#333 !important; }
#glossario h2 { margin:0; }
#glossario p { margin:0; }
#glossario div { padding:0 !important; border:0 !important; }
#glossario a { color:#6086A6; }
#glossario ul#demoOne { margin-left:15px }
#glossario ul#demoOne li { padding:0; margin:0; list-style:none }
#glossario ul#demoOne li a { display:block; padding:5px; border-bottom:1px dashed #CCC; }
#glossario ul#demoOne li a:hover { background: #D5F0EF; }
#glossario form { float:right; margin:-14px 0 0 0; }
#glossario form input[type="text"] { padding:3px; font:bold 13px Verdana, Geneva, sans-serif; }
